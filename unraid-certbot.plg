<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "unraid-certbot">
<!ENTITY author    "tautcony">
<!ENTITY version   "2026.09.15">
<!ENTITY launch    "Settings/UnraidCertbot">
<!ENTITY github    "tautcony/unraid-certbot">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/master/&name;.plg">
<!ENTITY pkgfile   "&name;-&version;-noarch-1.txz">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        icon="certificate"
        min="6.9.0"
        project="https://github.com/&github;">

<CHANGES>
###2026.09.15
- 修正日志数据刷新
- 修复设置表单布局异常
- 新增证书目录文件系统检查
- 默认证书目录改为 /mnt/user/appdata/letsencrypt
###2026.09.11
- 修正入口结构：设置 → 网络服务 → Unraid Certbot
###2026.09.10
- 首个版本：Cloudflare DNS-01 验证，为 webGUI 签发并续期 Let's Encrypt 证书
- 设置页配置 Token / 邮箱 / 主机名 / 域名 / 存储目录 / 续期频率
- 状态页展示证书详情、续期历史与运行日志，支持手动与强制续期
- 卸载保留证书与配置
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p /boot/config/plugins/&name;
[ -f /boot/config/plugins/&name;/cloudflare.ini ] &amp;&amp; chmod 600 /boot/config/plugins/&name;/cloudflare.ini
exit 0
</INLINE>
</FILE>

<FILE Name="/boot/config/plugins/&name;/&pkgfile;" Run="upgradepkg --install-new">
<URL>https://github.com/&github;/releases/download/&version;/&pkgfile;</URL>
<MD5>79b59b76bb1577d8e58fd695f4414a2e</MD5>
<SHA256>ed8b4ad6071a478b8a0460bff38f5f0872254512d0cb0e4404d9b1e54564c074</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
P=/usr/local/emhttp/plugins/&name;
MARKER=/boot/config/plugins/&name;/installed.version
if [ -f "$MARKER" ]; then
  ACTION="升级"
else
  ACTION="安装"
fi
printf '%s\n' "&version;" > "$MARKER" 2>/dev/null

chmod 0755 "$P"/scripts/*.sh "$P"/event/* 2>/dev/null
chmod 0644 "$P"/*.page "$P"/default.cfg 2>/dev/null

# 证书目录默认在 /mnt/user/appdata 下，只有阵列启动后才存在。
# 阵列已启动则此时建好，未启动则跳过 —— 首次续期时 renew.sh 会再建一次。
CERT_DIR=/mnt/user/appdata/letsencrypt
if grep -q '^shfs /mnt/user ' /proc/mounts 2>/dev/null; then
  if mkdir -p "$CERT_DIR" 2>/dev/null; then
    chmod 700 "$CERT_DIR" 2>/dev/null
    echo "证书目录已就绪：$CERT_DIR"
  else
    echo "警告：无法创建 $CERT_DIR，请检查阵列与共享设置"
  fi
else
  echo "提示：阵列未启动，暂未创建 $CERT_DIR（启动阵列后首次续期会自动创建）"
fi

[ -f /boot/config/plugins/&name;/cloudflare.ini ] &amp;&amp; chmod 600 /boot/config/plugins/&name;/cloudflare.ini
/usr/local/sbin/update_cron 2>/dev/null

echo "&name; ${ACTION}完成，请到 设置 → 网络服务 → Unraid Certbot 配置"
exit 0
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -f /boot/config/plugins/&name;/*.cron
/usr/local/sbin/update_cron 2>/dev/null
pkill -f "plugins/&name;/scripts/renew.sh" 2>/dev/null
rm -rf /var/run/&name;.lock.d
removepkg &name; 2>/dev/null
rm -rf /usr/local/emhttp/plugins/&name;

echo "&name; 已卸载，证书与配置已保留"
exit 0
</INLINE>
</FILE>

</PLUGIN>
