<?php
/**
 * 工具 → Cert Status：只是 设置 → 网络服务 → Unraid Certbot 的另一个入口。
 *
 * 状态、设置、历史的正文只有一份，都在 unraid-certbot.page 里；
 * 这里不做任何渲染，直接把浏览器送到「证书状态」标签。
 *
 * 兜底：万一 Unraid 在正文执行前已经输出了内容（headers_sent()），
 * 就用 meta 刷新，页面上的链接也能进到同一个地址。
 */
if (!headers_sent()) {
    header('Location: /Settings/UnraidCertbot?tab=status', true, 302);
}
?>
