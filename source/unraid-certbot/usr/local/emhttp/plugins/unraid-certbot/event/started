#!/bin/bash
#
# unraid-certbot - emhttp 事件钩子：阵列启动完成（started）
#
# 默认关闭。仅当用户在设置页勾选「阵列启动后自动检查一次」时执行，
# 因为多数情况下 cron 定时检查已足够。
#
# emhttp 会阻塞等待事件脚本返回，因此实际续期须转至后台执行，
# 否则会阻塞整个启动流程。

PLUGIN="unraid-certbot"

# CB_DEV_ROOT 把系统路径映射到沙箱，生产环境为空
DEV_ROOT="${CB_DEV_ROOT:-}"
PLUGIN_DIR="${DEV_ROOT}/usr/local/emhttp/plugins/${PLUGIN}"
CFG_FILE="${DEV_ROOT}/boot/config/plugins/${PLUGIN}/${PLUGIN}.cfg"

[ -x "${PLUGIN_DIR}/scripts/renew.sh" ] || exit 0

# 读 RUN_AT_BOOT，只有显式写成 yes 才继续
run_at_boot="no"
if [ -f "$CFG_FILE" ]; then
  v=$(grep -E '^[[:space:]]*RUN_AT_BOOT[[:space:]]*=' "$CFG_FILE" 2>/dev/null \
      | tail -n1 \
      | sed -E 's/^[^=]*=[[:space:]]*//' \
      | tr -d '"'"'"'[:space:]')
  [ "$v" = "yes" ] && run_at_boot="yes"
fi
[ "$run_at_boot" = "yes" ] || exit 0

# 等 Docker 守护进程就绪再执行，失败也无妨 —— cron 会照常检查
( sleep 90; "${PLUGIN_DIR}/scripts/renew.sh" --quiet --trigger=boot ) >/dev/null 2>&1 &

exit 0
