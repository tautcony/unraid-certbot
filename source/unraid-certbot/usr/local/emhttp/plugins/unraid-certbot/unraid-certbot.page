<?php
/**
 * Unraid Certbot：设置 → 网络服务 → Unraid Certbot。
 *
 * 标签状态用 ?tab= 记录。
 */
$cb = 'unraid-certbot';
require_once "$docroot/plugins/dynamix/include/Wrappers.php";
require_once "$docroot/plugins/$cb/include/status.php";
require_once "$docroot/plugins/$cb/include/config-form.php";
require_once "$docroot/plugins/$cb/include/status-panel.php";
require_once "$docroot/plugins/$cb/include/history-panel.php";

$cfg = parse_plugin_cfg($cb);
$st  = cb_status($cfg);

$tabs = [
    'status'  => 'Certificate Status',
    'config'  => 'Settings',
    'history' => 'Renewal History',
    'log'     => 'Run Log',
];
$tab = (string)($_GET['tab'] ?? 'status');
if (!isset($tabs[$tab])) {
    $tab = 'status';
}

// 缺配置时给出待办清单，避免用户遗漏必填项
$missing = [];
if (!$st['configured']['token'])   $missing[] = 'Cloudflare API Token';
if (!$st['configured']['email'])   $missing[] = cb_t('Email');
if (!$st['configured']['host'])    $missing[] = cb_t('Unraid Hostname');
if (!$st['configured']['domains']) $missing[] = cb_t('Domains');

$log = cb_log_tail(400);
$historyPage = max(1, (int)($_GET['history_page'] ?? 1));
?>

<div id="cb-tabs">
  <?php foreach ($tabs as $key => $label): ?>
  <button type="button" class="<?=$key === $tab ? 'active' : ''?>" onclick="cbTab('<?=$key?>')"><?=cb_t($label)?></button>
  <?php endforeach; ?>
</div>

<!-- ======================= 证书状态 ======================= -->
<div id="cb-pane-status" class="cb-pane"<?=$tab === 'status' ? '' : ' style="display:none"'?>>
<?php cb_status_panel($st, $cb); ?>
</div>

<!-- ======================= 设置 ======================= -->
<div id="cb-pane-config" class="cb-pane"<?=$tab === 'config' ? '' : ' style="display:none"'?>>
<div id="cb-update-result" role="status" aria-live="polite" style="display:none"></div>
<?php cb_form($cfg, $missing); ?>
</div>

<!-- ======================= 续期历史 ======================= -->
<div id="cb-pane-history" class="cb-pane"<?=$tab === 'history' ? '' : ' style="display:none"'?>>
<?php cb_history_panel($cb, $historyPage); ?>
</div>

<!-- ======================= 运行日志 ======================= -->
<div id="cb-pane-log" class="cb-pane"<?=$tab === 'log' ? '' : ' style="display:none"'?>>
<p class="grey-text" style="font-size:12px;margin-bottom:6px">
  <?=cb_t('Shows the last 400 lines of')?> <code>/boot/config/plugins/<?=$cb?>/certbot.log</code><br><?=cb_t('Logs are truncated automatically after 1 MiB.')?>
</p>
<?php if (trim($log) === ''): ?>
<blockquote class="inline_help" style="display:block"><?=cb_t('No log entries.')?></blockquote>
<?php else: ?>
<div id="cb-log-content" class="cb-log"><?=cb_e($log)?></div>
<?php endif; ?>
</div>

<script>
var cbTabKeys = <?=json_encode(array_keys($tabs), JSON_UNESCAPED_UNICODE)?>;
var cbTabNow  = <?=json_encode($tab, JSON_UNESCAPED_UNICODE)?>;
var cbDirty   = false;   // 「设置」标签中存在未保存的改动

// 加 _ 参数以绕过浏览器缓存，导航后立即用 replaceState 移除。
function cbTab(name) {
  if (name === cbTabNow) { return; }
  if (cbTabNow === 'config' && cbDirty) {
    if (!window.confirm(<?=json_encode(cb_t('You have unsaved changes. Leave this tab?'), JSON_UNESCAPED_UNICODE)?>)) {
      return;
    }
  }
  var url = new URL(location.href);
  url.searchParams.set('tab', name);
  url.searchParams.delete('history_page');
  url.searchParams.set('_', Date.now());
  location.assign(url.toString());
}

function cbHistoryPage(page) {
  var url = new URL(location.href);
  url.searchParams.set('tab', 'history');
  if (page <= 1) {
    url.searchParams.delete('history_page');
  } else {
    url.searchParams.set('history_page', String(page));
  }
  url.searchParams.set('_', Date.now());
  location.assign(url.toString());
}

if (cbTabNow === 'log') {
  var cbScrollLogToEnd = function () {
    requestAnimationFrame(function () {
      var log = document.getElementById('cb-log-content');
      if (log) { log.scrollTop = log.scrollHeight; }
    });
  };
  if (document.readyState === 'complete') {
    cbScrollLogToEnd();
  } else {
    window.addEventListener('load', cbScrollLogToEnd, {once: true});
  }
}

function cbEnableApply(form) {
  if (!form) return;
  Array.prototype.forEach.call(form.querySelectorAll('input[type=submit][disabled]'), function (b) {
    b.disabled = false;
  });
}
function cbMarkDirty(form) {
  if (form && form.id === 'cb-config-form') { cbDirty = true; }
}
document.addEventListener('input',  function (e) { cbEnableApply(e.target.form); cbMarkDirty(e.target.form); }, true);
document.addEventListener('change', function (e) { cbEnableApply(e.target.form); cbMarkDirty(e.target.form); }, true);

// 清除缓存参数和不属于当前标签的分页参数。
try {
  var clean = new URL(location.href);
  var changed = false;
  if (clean.searchParams.has('_')) {
    clean.searchParams.delete('_');
    changed = true;
  }
  if (cbTabNow !== 'history' || Number(clean.searchParams.get('history_page')) <= 1) {
    if (clean.searchParams.has('history_page')) {
      clean.searchParams.delete('history_page');
      changed = true;
    }
  }
  if (changed) { history.replaceState(null, '', clean.toString()); }
} catch (e) {}

// 「显示 / 隐藏」Token
function cbToggle(id, btn) {
  var el = document.getElementById(id);
  if (!el) return;
  var show = el.type === 'password';
  el.type = show ? 'text' : 'password';
  btn.value = show ? '<?=cb_t('Hide')?>' : '<?=cb_t('Show')?>';
}

// 重取当前标签
function cbReload(saved) {
  var url = new URL(location.href);
  url.searchParams.set('tab', cbTabNow);
  if (cbTabNow !== 'history') { url.searchParams.delete('history_page'); }
  url.searchParams.set('_', Date.now());
  if (saved) { url.searchParams.set('_saved', '1'); }
  location.replace(url.toString());
}

// 保存并重取之后，地址里带着 _saved；把提示补上并在标签内显示
(function () {
  try {
    var q = new URL(location.href).searchParams;
    if (!q.has('_saved')) { return; }
    cbSaveResult(true, <?=json_encode(cb_t('Settings saved'), JSON_UNESCAPED_UNICODE)?>, false);
    q.delete('_saved');
    history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q.toString() : ''));
  } catch (e) {}
})();

// 续期类动作在对话框中执行，输出经 addLog
function cbRun(action) {
  var titles = {
    renew:  '<?=cb_t('Check and renew')?>',
    force:  '<?=cb_t('Force renewal')?>',
    docker: '<?=cb_t('Check Docker environment')?>'
  };
  openBox('/plugins/<?=$cb?>/include/exec.php?action=' + action, titles[action] || action, 820, 560);
}

// 帮助说明：点击 dt 展开/收起对应 dd 内的 blockquote.inline_help。
function cbBindHelp() {
  var panes = document.querySelectorAll('#cb-pane-config dl');
  for (var d = 0; d < panes.length; d++) {
    var dts = panes[d].querySelectorAll('dt');
    for (var i = 0; i < dts.length; i++) {
      dts[i].style.cursor = 'help';
      (function (dt) {
        if (dt.dataset.cbHelp) return;
        dt.dataset.cbHelp = '1';
        dt.addEventListener('click', function () {
          var dd = dt.nextElementSibling;
          if (!dd || dd.tagName !== 'DD') return;
          var bq = dd.querySelector('blockquote.inline_help');
          if (!bq) return;
          bq.style.display = bq.style.display === 'block' ? '' : 'block';
        });
      })(dts[i]);
    }
  }
}
cbBindHelp();

// 保存结果保持在设置页内，避免依赖 Unraid 的隐藏 progressFrame。
function cbSaveResult(ok, msg, reload, details, pending) {
  var panel = document.getElementById('cb-update-result');
  if (panel) {
    panel.style.display = 'block';
    panel.dataset.state = pending ? 'pending' : (ok ? 'success' : 'error');
    panel.textContent = '';
    var heading = document.createElement('b');
    heading.textContent = msg || (ok ? <?=json_encode(cb_t('Settings saved'), JSON_UNESCAPED_UNICODE)?> : <?=json_encode(cb_t('Settings not saved'), JSON_UNESCAPED_UNICODE)?>);
    panel.appendChild(heading);
    if (Array.isArray(details) && details.length) {
      var list = document.createElement('ul');
      details.forEach(function (detail) {
        var item = document.createElement('li');
        item.textContent = String(detail);
        list.appendChild(item);
      });
      panel.appendChild(list);
    }
  }
  if (!ok) { return; }
  cbDirty = false;
  if (reload !== false) { setTimeout(function () { cbReload(true); }, 1200); }
}

var cbConfigForm = document.getElementById('cb-config-form');
if (cbConfigForm) {
  var cbSaving = false;
  cbConfigForm.addEventListener('submit', function (event) {
    event.preventDefault();
    if (cbSaving) { return; }
    cbSaving = true;
    var button = cbConfigForm.querySelector('input[type="submit"]');
    if (button) { button.disabled = true; }
    cbSaveResult(false, <?=json_encode(cb_t('Saving settings...'), JSON_UNESCAPED_UNICODE)?>, false, null, true);
    var controller = new AbortController();
    var timeout = setTimeout(function () { controller.abort(); }, 30000);
    fetch(cbConfigForm.action, {
      method: 'POST',
      body: new URLSearchParams(new FormData(cbConfigForm)),
      credentials: 'same-origin',
      signal: controller.signal,
      headers: {'Accept': 'application/json'}
    }).then(function (response) {
      if (!response.ok) { throw new Error('HTTP ' + response.status); }
      return response.json();
    }).then(function (result) {
      if (!result || typeof result.ok !== 'boolean') { throw new Error('Invalid save response'); }
      cbSaveResult(result.ok, result.message, true, result.details);
      if (!result.ok) { cbSaving = false; if (button) { button.disabled = false; } }
    }).catch(function (error) {
      cbSaveResult(false,
        error && error.name === 'AbortError'
          ? <?=json_encode(cb_t('Settings save timed out. Reload to confirm before trying again.'), JSON_UNESCAPED_UNICODE)?>
          : <?=json_encode(cb_t('Settings not saved'), JSON_UNESCAPED_UNICODE)?>, false);
      cbSaving = false;
      if (button) { button.disabled = false; }
    }).finally(function () {
      clearTimeout(timeout);
    });
  });
}
</script>
