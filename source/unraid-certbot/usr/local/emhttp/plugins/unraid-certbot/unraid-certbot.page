<?php
/**
 * Unraid Certbot：设置 → 网络服务 → Unraid Certbot（唯一入口）。
 *
 * 整页三个标签，默认进入「证书状态」：
 *   - 证书状态：整体状态、WebGUI 与 certbot 证书、运行环境、续期/强制续期按钮
 *   - 设置：Token / 邮箱 / 主机名 / 域名 / 存储目录 / 续期频率（include/config-form.php）
 *   - 续期历史：history.tsv 最近若干条
 *   - 运行日志：certbot.log 末尾若干行
 *
 * 没有二级入口，也没有弹窗；工具菜单里的 Cert Status 是同一页的另一个入口
 * （见同目录 CertStatus.page，它只做跳转，内容只有这一份）。
 *
 * 标签状态用 ?tab= 记录，刷新与收藏都能回到原标签。
 */
$cb = 'unraid-certbot';
require_once "$docroot/plugins/dynamix/include/Wrappers.php";
require_once "$docroot/plugins/$cb/include/status.php";
require_once "$docroot/plugins/$cb/include/config-form.php";
require_once "$docroot/plugins/$cb/include/status-panel.php";
require_once "$docroot/plugins/$cb/include/history-panel.php";

$cfg = parse_plugin_cfg($cb);
$st  = cb_status($cfg);

$tabs = [
    'status'  => '证书状态',
    'config'  => '设置',
    'history' => '续期历史',
    'log'     => '运行日志',
];
$tab = (string)($_GET['tab'] ?? 'status');
if (!isset($tabs[$tab])) {
    $tab = 'status';
}

// 缺配置时给出待办清单，避免用户不知道要填哪几项
$missing = [];
if (!$st['configured']['token'])   $missing[] = 'Cloudflare API Token';
if (!$st['configured']['email'])   $missing[] = '邮箱';
if (!$st['configured']['host'])    $missing[] = 'Unraid 主机名';
if (!$st['configured']['domains']) $missing[] = '域名';

$log = $tab === 'log' ? cb_log_tail(400) : '';
?>

<style>
#cb-tabs{margin:0 0 1.2rem 0;border-bottom:1px solid var(--border-color);display:flex;gap:.5rem;flex-wrap:wrap;}
#cb-tabs button{background:transparent;border:1px solid transparent;border-bottom:2px solid transparent;border-radius:6px 6px 0 0;color:var(--text-color);opacity:.55;padding:.75rem 1rem;font-size:1.4rem;letter-spacing:1.8px;cursor:pointer;font-family:inherit;}
#cb-tabs button:hover{border-color:var(--brand-orange);border-bottom-color:transparent;color:var(--text-color);opacity:1;}
#cb-tabs button.active{border-color:var(--brand-orange);border-bottom-color:transparent;color:var(--text-color);opacity:1;}
.cb-table{width:100%;border-collapse:collapse;}
.cb-table th,.cb-table td{padding:6px 10px;text-align:left;border-bottom:1px solid var(--table-border-color);vertical-align:top;}
.cb-table th{color:var(--alt-text-color);font-weight:normal;}
.cb-log{background:#1e1e1e;color:#d4d4d4;padding:12px;border-radius:4px;font-family:var(--font-bitstream,Menlo,Consolas,monospace);font-size:12px;line-height:1.5;max-height:520px;overflow:auto;white-space:pre-wrap;word-break:break-all;}
.cb-badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:12px;}
.cb-ok{background:var(--green-100,#e6f4ea);color:var(--green-900,#137333);}
.cb-fail{background:var(--red-100,#fce8e6);color:var(--red-900,#c5221f);}
.cb-actions input[type=button]{margin-right:8px;}
/* 设置标签的表单比较长，底部留点余量，免得贴着页脚 */
#cb-pane-config{padding-bottom:1.5rem;}
</style>

<div id="cb-tabs">
  <?php foreach ($tabs as $key => $label): ?>
  <button type="button" class="<?=$key === $tab ? 'active' : ''?>" onclick="cbTab('<?=$key?>')"><?=_($label)?></button>
  <?php endforeach; ?>
</div>

<!-- ======================= 证书状态 ======================= -->
<div id="cb-pane-status" class="cb-pane"<?=$tab === 'status' ? '' : ' style="display:none"'?>>
<?php cb_status_panel($st, $cb); ?>
</div>

<!-- ======================= 设置 ======================= -->
<div id="cb-pane-config" class="cb-pane"<?=$tab === 'config' ? '' : ' style="display:none"'?>>
<?php if ($missing): ?>
<blockquote class="inline_help cb-help-open">
<b>还差几项配置：<?=cb_e(implode('、', $missing))?></b><br>
填好后点「应用」。首次使用建议先勾选「测试环境」验证流程，确认无误后取消勾选并正式签发。
</blockquote>
<?php endif; ?>
<blockquote id="cb-update-result" class="inline_help" style="display:none"></blockquote>
<?php cb_form($cfg); ?>
</div>

<!-- ======================= 续期历史 ======================= -->
<div id="cb-pane-history" class="cb-pane"<?=$tab === 'history' ? '' : ' style="display:none"'?>>
<?php cb_history_panel($st, $cb); ?>
</div>

<!-- ======================= 运行日志 ======================= -->
<div id="cb-pane-log" class="cb-pane"<?=$tab === 'log' ? '' : ' style="display:none"'?>>
<p class="grey-text" style="font-size:12px;margin-bottom:6px">
  <code>/boot/config/plugins/<?=$cb?>/certbot.log</code>，显示最后 400 行，超过 1 MiB 时自动截断。
</p>
<?php if (trim($log) === ''): ?>
<blockquote class="inline_help cb-help-open">日志还是空的。</blockquote>
<?php else: ?>
<div class="cb-log"><?=cb_e($log)?></div>
<?php endif; ?>
</div>

<script>
// 切换标签：显示对应面板，并把 tab 写进地址栏（刷新、收藏都能回到同一标签）。
// 用 replaceState 而不是 location.hash，免得给 Unraid 的 history 添乱。
function cbTab(name) {
  document.querySelectorAll('.cb-pane').forEach(function (el) { el.style.display = 'none'; });
  document.querySelectorAll('#cb-tabs button').forEach(function (el) { el.classList.remove('active'); });
  var pane = document.getElementById('cb-pane-' + name);
  if (pane) pane.style.display = '';
  var keys = Object.keys(<?=json_encode($tabs, JSON_UNESCAPED_UNICODE)?>);
  var idx  = keys.indexOf(name);
  var btns = document.querySelectorAll('#cb-tabs button');
  if (idx >= 0 && btns[idx]) btns[idx].classList.add('active');
  try {
    var url = new URL(location.href);
    url.searchParams.set('tab', name);
    history.replaceState(null, '', url);
  } catch (e) {}
}

// 真机外壳会在表单有改动时才启用「应用」；这里兜一份，
// 保证直接深链到设置标签、或从别的标签切回来都能保存。
function cbEnableApply(form) {
  if (!form) return;
  Array.prototype.forEach.call(form.querySelectorAll('input[type=submit][disabled]'), function (b) {
    b.disabled = false;
  });
}
document.addEventListener('input',  function (e) { cbEnableApply(e.target.form); }, true);
document.addEventListener('change', function (e) { cbEnableApply(e.target.form); }, true);

// 「显示 / 隐藏」Token
function cbToggle(id, btn) {
  var el = document.getElementById(id);
  if (!el) return;
  var show = el.type === 'password';
  el.type = show ? 'text' : 'password';
  btn.value = show ? '<?=_('隐藏')?>' : '<?=_('显示')?>';
}

// 续期类动作在对话框里跑，输出走 addLog
function cbRun(action) {
  var titles = {
    renew:  '<?=_('检查并续期')?>',
    force:  '<?=_('强制续期')?>',
    docker: '<?=_('Docker 环境检查')?>'
  };
  openBox('/plugins/<?=$cb?>/include/exec.php?action=' + action, titles[action] || action, 820, 560);
}

// 保存结束后把结果显示在设置表单上方（进度输出仍由 Unraid 的 progressFrame 提供）。
// 名字带 cb 前缀是插件自己的，避免和 Unraid 或主题里的同名函数撞车。
function cbSaveResult(ok, msg) {
  var panel = document.getElementById('cb-update-result');
  if (!panel) return;
  panel.style.display = '';
  panel.className = 'inline_help cb-help-open';
  panel.innerHTML = '<b>' + (msg || (ok ? '设置已保存' : '设置未保存')) + '</b>';
}
</script>
